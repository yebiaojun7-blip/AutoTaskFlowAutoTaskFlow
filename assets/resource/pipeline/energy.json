{
  "OpenEnergyApp": {
    "action": "Custom",
    "custom_action": "taobao_start_app",
    "post_delay": 5000,
    "next": ["OpenEnergyPage"]
  },
  "OpenEnergyPage": {
    "action": "Custom",
    "custom_action": "taobao_open_energy_page",
    "post_delay": 1500,
    "next": ["EnergyTaskLoop"],
    "on_error": ["AbortEnergyTask"]
  },
  "EnergyTaskLoop": {
    "recognition": "DirectHit",
    "action": "Custom",
    "custom_action": "taobao_energy_loop",
    "pre_delay": 300,
    "post_delay": 300,
    "timeout": 600000,
    "next": ["[JumpBack]SafetyVerify", "FinalStop"],
    "on_error": ["AbortEnergyTask"]
  },
  "AbortEnergyTask": {
    "recognition": "DirectHit",
    "action": "Custom",
    "custom_action": "taobao_abort",
    "custom_action_param": {
      "reason": "进不去双11赚能量面板"
    }
  }
}

